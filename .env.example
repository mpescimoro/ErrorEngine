# ============================================
# ErrorEngine - Configuration
# ============================================
# Copy this file to .env and change the values

# === DATABASE ===
# Connections to the monitored databases (Oracle, PostgreSQL, MySQL, SQL Server,
# SQLite, IBM i) are set up in the web interface, under DB connections

# === EMAIL (SMTP/Exchange) ===
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=sender@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# === FLASK ===
# Generate a random secret key for production
SECRET_KEY=change-this-to-a-random-string

# === LOGIN (single user) ===
# Username (default: admin)
# ERRORENGINE_USER=admin
# Password hash: generate it with this command and paste the result here
#   venv\Scripts\python.exe -c "import getpass; from werkzeug.security import generate_password_hash as h; print(h(getpass.getpass('Password: ')))"
ERRORENGINE_PASSWORD_HASH=
# Optional: token to call the APIs from scripts (header "Authorization: Bearer <token>")
# ERRORENGINE_API_TOKEN=
# Hours of inactivity after which the session expires (default: 12)
# ERRORENGINE_SESSION_HOURS=12

# === SERVER (serve.py) ===
# ERRORENGINE_HOST=0.0.0.0
# ERRORENGINE_PORT=5000

# === OPTIONAL ===
# Log detail: DEBUG, INFO (default), WARNING, ERROR
# LOG_LEVEL=INFO
# HTTP_TIMEOUT_SECONDS=30

# === TIMEOUTS AND SCHEDULER ===
# Maximum wait to connect to a monitored database and for a query (seconds)
# DB_CONNECT_TIMEOUT_SECONDS=15
# DB_QUERY_TIMEOUT_SECONDS=300
# Maximum wait for the SMTP server (seconds)
# MAIL_TIMEOUT_SECONDS=30
# The server certificate is always checked. For an internal SMTP server with its
# own certificate, the path of its CA (or of the certificate itself), PEM format
# MAIL_CA_FILE=C:\ErrorEngine\smtp-ca.pem
# Queries run in parallel
# SCHEDULER_MAX_WORKERS=4

# === FAILED NOTIFICATIONS ===
# Retried with longer and longer waits for this many hours from when the error
# appeared, then marked as not delivered on the Errors page
# NOTIFY_RETRY_HOURS=24

# === ALERTS ON FAILING QUERIES ===
# Alert when a query cannot read its source N times in a row
# (after a failure the scheduler retries every minute; 0 = no alert)
# MONITOR_FAILURE_THRESHOLD=3
# Who receives these alerts (comma-separated); if empty, the query's recipients
# ERRORENGINE_ADMIN_EMAILS=it@yourdomain.com

# === RETENTION (days) ===
# LOG_RETENTION_DAYS=30
# EMAIL_LOG_RETENTION_DAYS=90
# RESOLVED_ERRORS_RETENTION_DAYS=60

# Time zone for displayed dates (default: UTC)
# Examples: Europe/Rome, America/New_York, Asia/Tokyo
TIMEZONE=Europe/Rome
