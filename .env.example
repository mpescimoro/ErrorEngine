# ============================================
# ErrorEngine - Configuration
# ============================================
# Copy this file to .env and fill in the values.
# These are the settings most installations need. Every other one is optional:
# see docs/configuration.md for the full list and the defaults.

# === SIGN-IN (required) ===
# A random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string
# Hash of the password (the user name is admin):
#   venv\Scripts\python.exe -c "import getpass; from werkzeug.security import generate_password_hash as h; print(h(getpass.getpass('Password: ')))"
ERRORENGINE_PASSWORD_HASH=

# Time zone of the dates shown, e.g. Europe/Rome, America/New_York
TIMEZONE=Europe/Rome

# === EMAIL ===
# Any SMTP server. Leave MAIL_SERVER empty to notify only through channels
# (Teams, Telegram, webhook). Relay without login and Microsoft 365: see the docs
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Address the emails are sent from (default: MAIL_USERNAME)
MAIL_DEFAULT_SENDER=
